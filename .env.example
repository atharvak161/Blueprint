# Copy to .env only if you are running the optional API server against a real
# database. The frontend works without any of this — it falls back to
# localStorage, which is the default and needs no configuration.

# Postgres connection string. lib/db throws on startup if this is unset, so the
# API server will not boot without it.
DATABASE_URL=postgresql://user:password@localhost:5432/blueprint

# Vite dev server port for the frontend (default 5173).
PORT=5173

# Port the API server listens on, and that the Vite dev proxy forwards to.
API_PORT=3001

# Set when building for GitHub Pages so asset paths resolve under a subpath.
# BASE_PATH=/Blueprint/
# GITHUB_PAGES=true
